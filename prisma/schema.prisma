// =============================================================================
// ProjectPilot Neuro – Prisma Schema
//
// This schema is designed ground-up for a neurodivergent-first academic project
// management platform. It is intentionally more expressive than a generic task
// tracker to reflect the cognitive, communicative, and collaborative realities
// of autistic and neurodivergent university student teams.
//
// Domain structure:
//   1. Auth & Core User
//   2. Role Profiles (Student / Supervisor / Coordinator)
//   3. Cognitive Support (CognitiveProfile, OverloadSignal, AccessibilitySetting)
//   4. Team & Project (Team, TeamMember, Project)
//   5. Task Intelligence (Task, Milestone, TaskDecomposition, AmbiguityFlag, DependencyLink)
//   6. Contribution Tracking (ContributionLog, ContributionTypeBreakdown)
//   7. Team Intelligence (TeamHealthSignal, WorkloadSnapshot, SocialFrictionEvent)
//   8. Consultation System (Availability, Booking, MeetingNote, ConsultationBrief, FeedbackParse)
//   9. Project Brain (DecisionLog, OpenQuestion, AssumptionRecord, FeedbackMemory)
//  10. AI Insights (AIInsight)
//  11. Notifications & Activity Logs
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  STUDENT
  SUPERVISOR
  COORDINATOR
}

// Team membership capability — separate from global account role.
// A STUDENT can be a MEMBER, LEADER, or CO_LEADER within a specific team.
// This does NOT change their global User.role; they remain STUDENT globally.
enum TeamMemberRole {
  MEMBER
  LEADER
  CO_LEADER
}

// --- Project & Task ---

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Type of dependency between two tasks
enum DependencyType {
  BLOCKS // sourceTask must complete before targetTask can start
  REQUIRES_OUTPUT // sourceTask produces an artifact needed by targetTask
  PARALLEL_OK // tasks can proceed together but should be coordinated
}

// How a student has contributed (used for fairness analysis)
enum ContributionType {
  CODE
  DESIGN
  RESEARCH
  WRITING
  PLANNING
  TESTING
  COORDINATION
  REVIEW // reviewing others' work, PR reviews, peer feedback
  DOCUMENTATION // writing docs, READMEs, architecture notes
  CLARIFICATION // resolving ambiguity, answering questions for the team
  MEETING_PREP // preparing agendas, consultation briefs
  UNBLOCKING_SUPPORT // helping a stuck team member get unstuck
  OTHER
}

// --- Team Intelligence ---

enum TeamHealthStatus {
  ON_TRACK
  AT_RISK
  CRITICAL
}

// Event types that signal social friction or disengagement within a team
enum FrictionEventType {
  SILENT_MEMBER // A member has had no recent activity
  REPEATED_CLARIFICATION // Same question asked multiple times (ambiguity burden)
  OVERLOAD_REPORTED // A student triggered an overload signal
  MISSED_DEADLINE // Task or milestone missed with no update
  DISENGAGEMENT // Sustained low contribution from a member
  CONFLICT // Logged interpersonal or task conflict
}

// --- Consultation ---

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Notification types are now free-form strings (see lib/events/types.ts for constants).
// This allows new event types to be added without schema migrations.

// --- Cognitive Support ---

// How the student prefers information to be structured for them
enum CommunicationStyle {
  DIRECT // Short, literal, to the point
  DETAILED // Full context and reasoning provided
  VISUAL_FIRST // Prefers structure, lists, diagrams described
  STEP_BY_STEP // Sequential, one thing at a time
  NARRATIVE // Context-rich, story-framed explanations
}

// How reminders should feel
enum ReminderStyle {
  GENTLE // Soft nudges with no urgency framing
  STRUCTURED // Calendar-like, predictable schedule
  DEADLINE_FOCUSED // Clear emphasis on deadline and consequence
  MINIMAL // As few reminders as possible
}

// Preferred meeting/consultation style
enum MeetingFormat {
  ASYNC_PREFERRED // Email, notes, or messages before any sync call
  SHORT_SYNC // Brief live conversations (≤15 min)
  STRUCTURED_AGENDA // Needs written agenda in advance
  FLEXIBLE // Adaptable to context
}

// How easily the student reaches cognitive overload
enum OverloadSensitivity {
  LOW // Handles heavy loads well
  MEDIUM
  HIGH // Easily overwhelmed; AI should proactively de-escalate
}

// Preferred work rhythm
enum PacingPreference {
  STEADY // Consistent daily progress
  SPRINT_REST // Intense bursts followed by recovery periods
  FLEXIBLE // No strong preference
}

// Comfort level when a task or instruction is ambiguous
enum AmbiguityComfort {
  LOW // Ambiguity is very distressing; needs clear steps
  MEDIUM
  HIGH // Can tolerate and navigate vague instructions
}

// How much AI/cognitive assistance the student wants
enum SupportMode {
  MINIMAL // Student prefers to self-manage; AI only on explicit request
  MODERATE // Proactive nudges for risk, ambiguity, and overload
  COMPREHENSIVE // Full support: decomposition, rewriting, pacing suggestions
}

// How often notification digests are sent
enum DigestMode {
  REALTIME
  DAILY
  WEEKLY
  NONE
}

// Severity of an AI insight, ambiguity flag, or friction event
enum SignalSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
}

// --- Academic Term Formation ---

// Lifecycle of an academic term used to scope formation batches
// =============================================================================
// PART 4 — PROJECT TOPIC CATALOGUE ENUMS
// =============================================================================

enum ProjectTopicStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum ProjectTopicDifficulty {
  LOW
  MEDIUM
  HIGH
}

enum ProjectPreferenceStatus {
  DRAFT
  SUBMITTED
}

enum ProjectSelectionConflictType {
  OVER_SELECTED
  UNDER_SELECTED
  NO_INTEREST
  SKILL_GAP
  STUDENT_MISSING_PREFERENCES
  CAPACITY_EXCEEDED
}

enum ProjectSelectionConflictSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// =============================================================================
// PART 5 — TEAM FORMATION ENGINE ENUMS
// =============================================================================

// Lifecycle of a single deterministic team-formation run.
enum TeamFormationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  ARCHIVED
}

// Status of a draft (pre-approval) team produced by the engine.
// These are NOT operational teams — Part 6 approves/publishes them.
enum DraftTeamStatus {
  DRAFT
  NEEDS_REVIEW
  READY
  LOCKED
}

// Categories of warning the engine can raise at run/team/student/topic level.
enum FormationWarningType {
  MISSING_CRITICAL_SKILL
  WEAK_SKILL_COVERAGE
  NO_CLEAR_LEADER
  SCHEDULE_CONFLICT
  CAPACITY_IMBALANCE
  PROJECT_OVER_SELECTED
  TOPIC_SKILL_GAP
  STUDENT_UNASSIGNED
  TEAM_SIZE_OUT_OF_RANGE
  SUPERVISOR_CAPACITY_RISK
  SUPPORT_COMPATIBILITY_RISK
  LOW_PREFERENCE_MATCH
  DUPLICATE_TOPIC_PRESSURE
  INCOMPLETE_STUDENT_PROFILE
  // Part 7 — role suitability engine
  MISSING_ROLE_COVERAGE
  LOW_ROLE_CONFIDENCE
  ROLE_AVOIDANCE_CONFLICT
  ROLE_SKILL_MISMATCH
}

enum FormationWarningSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// =============================================================================
// PART 3 — STUDENT FORMATION PROFILE ENUMS
// =============================================================================

enum FormationProfileStatus {
  DRAFT
  SUBMITTED
  NEEDS_REVIEW
}

enum SkillLevelSource {
  SELF_ASSESSED
  COURSEWORK
  PROJECT_EXPERIENCE
  SUPERVISOR_VERIFIED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AvailabilityBlock {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum AvailabilityLevel {
  PREFERRED
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum AcademicTermStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

// Where a student sits in the intake → team journey for a given term
enum StudentIntakeStatus {
  INVITED
  PROFILE_PENDING
  READY_FOR_FORMATION
  ASSIGNED_TO_TEAM
  WITHDRAWN
}

// Workflow states for a formation run
enum FormationBatchStatus {
  DRAFT
  READY
  RUNNING
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

// How a student is treated within a specific formation batch
enum FormationBatchStudentStatus {
  INCLUDED
  EXCLUDED
  LOCKED
  ASSIGNED
}

// Entity types used by polymorphic insight/flag records
enum AIEntityType {
  TASK
  MILESTONE
  TEAM
  PROJECT
  STUDENT
  CONSULTATION
  MEETING_NOTE
}

// The category of an AI insight
enum InsightType {
  AMBIGUITY // Something is unclear
  OVERLOAD_RISK // Member approaching capacity
  DEPENDENCY // Hidden or undocumented task dependency
  FAIRNESS // Workload distribution imbalance
  TASK_RISK // Task at risk of missing deadline
  MILESTONE_RISK // Milestone health concern
  POSITIVE // Celebration or encouragement
  SUGGESTION // Actionable improvement
}

// =============================================================================
// AUTH MODELS (required by NextAuth Prisma adapter)
// =============================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// CORE USER
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // bcrypt hash for credentials provider
  name          String?
  image         String?
  role          UserRole
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Role-specific profiles (at most one will be populated per user)
  studentProfile     StudentProfile?
  supervisorProfile  SupervisorProfile?
  coordinatorProfile CoordinatorProfile?

  // Shared relations (any role can have these)
  accessibilitySetting AccessibilitySetting?
  notifications        Notification[]
  activityLogs         ActivityLog[]

  // Team memberships (students)
  teamMemberships TeamMember[]

  // Task assignment (students and supervisors can be assignees)
  assignedTasks Task[] @relation("TaskAssignee")

  // Contribution logs (students)
  contributionLogs ContributionLog[]

  // Meeting notes authored (supervisors)
  meetingNotes MeetingNote[]

  // Overload signals (students)
  overloadSignals OverloadSignal[]

  // Project Brain entries authored by this user
  decisionLogs      DecisionLog[]
  openQuestions     OpenQuestion[]
  assumptionRecords AssumptionRecord[]
  feedbackMemories  FeedbackMemory[]

  // Formation batches created by this user (coordinators)
  createdFormationBatches FormationBatch[] @relation("FormationBatchCreator")

  // Project topics created by this user (coordinators/supervisors)
  createdProjectTopics ProjectTopic[] @relation("ProjectTopicCreator")

  // Team formation runs created by this user (coordinators)
  createdTeamFormationRuns TeamFormationRun[] @relation("TeamFormationRunCreator")

  // Team formation runs published by this user (coordinators)
  publishedTeamFormationRuns TeamFormationRun[] @relation("TeamFormationRunPublisher")
}

// =============================================================================
// ROLE PROFILES
// =============================================================================

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  studentId String? // university student ID number
  year      Int? // academic year (1-4)
  faculty   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cognitiveProfile          CognitiveProfile?
  teamMemberships           TeamMember[]
  intakeRecords             StudentIntake[]
  formationProfile          StudentFormationProfile?
  projectPreferences        ProjectPreference[]
  projectSelectionConflicts ProjectSelectionConflict[]
  draftTeamMemberships      DraftTeamMember[]
  draftTeamWarnings         DraftTeamWarning[]
}

model SupervisorProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  title      String? // e.g. "Dr.", "Prof."
  department String?
  bio        String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  supervisedTeams Team[]                     @relation("TeamSupervisor")
  availability    ConsultationAvailability[]
  projectTopics   ProjectTopic[]
  draftTeams      DraftTeam[]
}

model CoordinatorProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =============================================================================
// COGNITIVE SUPPORT DOMAIN
// =============================================================================

// The cognitive profile is the heart of the neurodivergent-first design.
// It captures each student's individual preferences so the AI layer can
// adapt communication, reminders, task framing, and pacing accordingly.
//
// Security note: this model contains sensitive personal support data.
// Fields like overloadSensitivity and supportMode should never be exposed
// in team-level or supervisor-level queries without explicit consent.
model CognitiveProfile {
  id     String @id @default(cuid())
  userId String @unique // references StudentProfile.userId

  // --- Communication & information style ---
  communicationStyle CommunicationStyle @default(STEP_BY_STEP)

  // --- Reminder preferences ---
  reminderStyle ReminderStyle @default(STRUCTURED)

  // --- Meeting / consultation preferences ---
  preferredMeetingFormat MeetingFormat @default(STRUCTURED_AGENDA)

  // --- Load and pacing ---
  overloadSensitivity OverloadSensitivity @default(MEDIUM)
  pacingPreference    PacingPreference    @default(STEADY)

  // --- Ambiguity handling ---
  ambiguityComfort AmbiguityComfort @default(MEDIUM)

  // --- Focus duration (typical productive session in minutes) ---
  focusDurationMinutes Int? // e.g. 25 (Pomodoro-style) or 90

  // --- AI support level ---
  supportMode SupportMode @default(MODERATE)

  // --- Preferred working hours stored as JSON ---
  // Format: { "preferredSlots": ["morning", "afternoon"], "avoidSlots": ["late_night"] }
  // Not indexed because it's not used for filtering.
  preferredWorkingHours Json?

  // --- Onboarding status ---
  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

// A log of moments when a student reported or triggered an overload state.
// Used to detect patterns and adjust support intensity.
model OverloadSignal {
  id          String         @id @default(cuid())
  userId      String
  triggeredAt DateTime       @default(now())
  // Brief context: "3 tasks assigned simultaneously", "unclear milestone scope", etc.
  context     String?
  severity    SignalSeverity @default(MEDIUM)
  resolved    Boolean        @default(false)
  resolvedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([triggeredAt])
}

// Per-user accessibility preferences. Any role can have this.
// This drives UI-level adaptations: focus mode, font scale, motion, etc.
model AccessibilitySetting {
  id            String     @id @default(cuid())
  userId        String     @unique
  reducedMotion Boolean    @default(false)
  highContrast  Boolean    @default(false)
  fontScale     String     @default("md") // sm | md | lg | xl
  focusMode     Boolean    @default(false) // hides non-essential UI elements
  lowEnergyMode Boolean    @default(false) // simplifies layout, mutes notifications
  digestMode    DigestMode @default(DAILY)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =============================================================================
// TEAM & PROJECT
// =============================================================================

model Team {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  healthStatus      TeamHealthStatus @default(ON_TRACK)
  supervisorId      String?
  // Optional links to the academic term and formation batch that produced this team
  academicTermId    String?
  formationBatchId  String?
  // Source draft team — set when published from the formation workspace (Part 6)
  sourceDraftTeamId String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  supervisor      SupervisorProfile? @relation("TeamSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  academicTerm    AcademicTerm?      @relation(fields: [academicTermId], references: [id], onDelete: SetNull)
  formationBatch  FormationBatch?    @relation(fields: [formationBatchId], references: [id], onDelete: SetNull)
  sourceDraftTeam DraftTeam?         @relation("DraftTeamPublishedTeam", fields: [sourceDraftTeamId], references: [id], onDelete: SetNull)

  members              TeamMember[]
  project              Project?
  consultationBookings ConsultationBooking[]
  healthSignals        TeamHealthSignal[]
  workloadSnapshots    WorkloadSnapshot[]
  frictionEvents       SocialFrictionEvent[]
  activityLogs         ActivityLog[]
  notifications        Notification[]

  @@index([supervisorId])
  @@index([healthStatus])
  @@index([academicTermId])
  @@index([formationBatchId])
  @@index([sourceDraftTeamId])
}

// A student's membership in a team. One student can technically be a member
// of multiple teams (e.g. across different courses), though the typical
// university setup has one team per student per course.
model TeamMember {
  id        String         @id @default(cuid())
  teamId    String
  userId    String
  profileId String // FK to StudentProfile.id for direct profile access
  role      TeamMemberRole @default(MEMBER)
  joinedAt  DateTime       @default(now())

  team    Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([profileId])
}

model Project {
  id          String        @id @default(cuid())
  teamId      String        @unique
  title       String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  team                       Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  milestones                 Milestone[]
  tasks                      Task[]
  contributionLogs           ContributionLog[]
  contributionTypeBreakdowns ContributionTypeBreakdown[]

  // Project Brain
  decisionLogs      DecisionLog[]
  openQuestions     OpenQuestion[]
  assumptionRecords AssumptionRecord[]
  feedbackMemories  FeedbackMemory[]
  activityLogs      ActivityLog[]
  notifications     Notification[]

  @@index([status])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?         @db.Text
  dueDate     DateTime
  status      MilestoneStatus @default(PENDING)
  orderIndex  Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks             Task[]
  linkedAssumptions AssumptionRecord[] @relation("MilestoneAssumptions")

  @@index([projectId])
  @@index([dueDate])
  @@index([status])
}

// =============================================================================
// TASK INTELLIGENCE
// =============================================================================

model Task {
  id               String        @id @default(cuid())
  projectId        String
  milestoneId      String? // optional: which milestone this task contributes to
  title            String
  description      String?       @db.Text
  // "What does done look like?" — explicit acceptance criteria reduce ambiguity for
  // neurodivergent students who need concrete definitions of completion.
  doneCriteria     String?       @db.Text
  // Why is this task currently blocked? Surfaced prominently in the workspace.
  blockerNote      String?       @db.Text
  // Subjective cognitive load 1–5 (1=quick, 5=heavy). Used for workload balance.
  cognitiveLoad    Int?
  status           TaskStatus    @default(TODO)
  priority         PriorityLevel @default(MEDIUM)
  dueDate          DateTime?
  assigneeId       String?
  // Estimated effort in minutes; used for workload balance calculations
  estimatedMinutes Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone     Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee      User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  decomposition TaskDecomposition?
  // Dependencies where this task is the "source" (this task depends on others)
  outgoingDeps  DependencyLink[]   @relation("SourceTask")
  // Dependencies where this task is the "target" (other tasks depend on this)
  incomingDeps  DependencyLink[]   @relation("TargetTask")

  @@index([projectId])
  @@index([milestoneId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
}

// AI-generated (or manually created) step-by-step breakdown of a complex task.
// Especially useful for students who find it hard to start a large, vague task.
model TaskDecomposition {
  id     String @id @default(cuid())
  taskId String @unique

  // JSON array of step objects: [{title, estimatedMinutes, orderIndex, done}]
  steps                 Json
  estimatedTotalMinutes Int?
  generatedBy           String   @default("rule-v1") // model or rule set version
  generatedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// Flags a piece of content (task, milestone, feedback) as ambiguous.
// Stored with a polymorphic entityType + entityId rather than hard FKs
// because ambiguity can attach to many different entity types.
model AmbiguityFlag {
  id          String         @id @default(cuid())
  entityType  AIEntityType
  entityId    String // ID of the flagged entity (no hard FK — polymorphic)
  description String         @db.Text // What specifically is ambiguous
  flaggedBy   String // userId or "system"
  severity    SignalSeverity @default(MEDIUM)
  flaggedAt   DateTime       @default(now())
  resolvedAt  DateTime?
  resolution  String?        @db.Text

  @@index([entityType, entityId])
  @@index([flaggedAt])
}

// Explicit dependency between two tasks. Discovered by users or the AI layer.
model DependencyLink {
  id             String         @id @default(cuid())
  sourceTaskId   String // The task that has the dependency
  targetTaskId   String // The task it depends on
  dependencyType DependencyType @default(BLOCKS)
  discoveredBy   String         @default("user") // "user" | "rule-v1"
  note           String?
  createdAt      DateTime       @default(now())

  sourceTask Task @relation("SourceTask", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTask Task @relation("TargetTask", fields: [targetTaskId], references: [id], onDelete: Cascade)

  @@unique([sourceTaskId, targetTaskId])
  @@index([sourceTaskId])
  @@index([targetTaskId])
}

// =============================================================================
// CONTRIBUTION TRACKING
// =============================================================================

model ContributionLog {
  id               String           @id @default(cuid())
  projectId        String
  userId           String
  description      String           @db.Text
  contributionType ContributionType @default(OTHER)
  hours            Float? // optional — used for effort-weighted fairness
  loggedAt         DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([loggedAt])
}

// A precomputed summary of contribution type distribution per user per project.
// Updated incrementally whenever a ContributionLog is added.
model ContributionTypeBreakdown {
  id               String           @id @default(cuid())
  projectId        String
  userId           String
  contributionType ContributionType
  count            Int              @default(0)
  totalHours       Float            @default(0)
  lastLoggedAt     DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, contributionType])
  @@index([projectId, userId])
}

// =============================================================================
// TEAM INTELLIGENCE
// =============================================================================

// Append-only health snapshots. Used to build health trend charts.
// The most recent snapshot reflects current health; older ones are history.
model TeamHealthSignal {
  id                     String           @id @default(cuid())
  teamId                 String
  healthStatus           TeamHealthStatus
  overdueTaskCount       Int
  totalOpenTasks         Int
  activeMemberCount      Int // members with activity in last 7 days
  hasActivityThisWeek    Boolean
  nextMilestoneIsOnTrack Boolean
  workloadIsFair         Boolean // simple flag based on task distribution
  recordedAt             DateTime         @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([recordedAt])
}

// Per-member workload snapshot at a point in time.
// Used to detect sustained imbalance or burnout risk.
model WorkloadSnapshot {
  id                      String   @id @default(cuid())
  teamId                  String
  userId                  String
  openTaskCount           Int
  overdueTaskCount        Int
  completedThisWeek       Int
  estimatedHoursRemaining Float?
  snapshotAt              DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, userId])
  @@index([snapshotAt])
}

// A logged event indicating social friction or disengagement within the team.
// These feed into the team health computation and AI insight generation.
model SocialFrictionEvent {
  id             String            @id @default(cuid())
  teamId         String
  eventType      FrictionEventType
  affectedUserId String? // null = whole team
  context        String?           @db.Text
  severity       SignalSeverity    @default(MEDIUM)
  flaggedAt      DateTime          @default(now())
  resolved       Boolean           @default(false)
  resolvedAt     DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([flaggedAt])
}

// =============================================================================
// CONSULTATION SYSTEM
// =============================================================================

model ConsultationAvailability {
  id             String   @id @default(cuid())
  supervisorId   String
  startTime      DateTime
  endTime        DateTime
  slotMinutes    Int      @default(30)
  isRecurring    Boolean  @default(false)
  notes          String?
  meetingMode    String?  @default("in-person") // "in-person" | "online" | "hybrid"
  locationOrLink String? // physical room or online meeting link
  isClosed       Boolean  @default(false) // supervisor can close a slot without deleting
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supervisor SupervisorProfile     @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  bookings   ConsultationBooking[]

  @@index([supervisorId])
  @@index([startTime])
}

model ConsultationBooking {
  id                  String        @id @default(cuid())
  teamId              String
  availabilityId      String
  slotStart           DateTime
  slotEnd             DateTime
  status              BookingStatus @default(PENDING)
  // The agenda entered by the team before the meeting.
  // Structured pre-consultation input reduces anxiety for neurodivergent students.
  agenda              String?       @db.Text
  // What the team wants to achieve in this meeting (structured booking context)
  purpose             String?       @db.Text
  // Blockers or stuck points the team wants to discuss
  blockerContext      String?       @db.Text
  // Specific questions or topics the team wants the supervisor to address
  topicsForSupervisor String?       @db.Text
  // Milestone this consultation is related to (optional)
  relatedMilestoneId  String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  team         Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  availability ConsultationAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  meetingNote   MeetingNote?
  brief         ConsultationBrief?
  feedbackParse SupervisorFeedbackParse?

  @@index([teamId])
  @@index([availabilityId])
  @@index([slotStart])
  @@index([status])
}

// The meeting notes written by the supervisor after a consultation.
// privateNote is for internal observations and should be encrypted at rest.
model MeetingNote {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  authorId    String
  content     String   @db.Text
  // Sensitive field — encrypted at rest using lib/encryption.ts before storage.
  privateNote String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User                @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

// AI-generated pre-meeting brief for the team, based on current project state.
// Shared with both the team and the supervisor before the consultation.
// Reduces "cold start" in meetings — especially helpful for anxious students.
model ConsultationBrief {
  id                   String   @id @default(cuid())
  bookingId            String   @unique
  teamProgressSummary  String   @db.Text
  // JSON arrays: see lib/services/supervisor-bridge.ts for shape definitions
  suggestedAgendaItems Json // string[]
  risksToHighlight     Json // { risk: string; severity: string }[]
  unresolvedQuestions  Json // string[]
  generatedAt          DateTime @default(now())
  generatedBy          String   @default("rule-v1")

  booking ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// A structured parse of raw supervisor feedback (from meeting notes or verbal).
// The AI bridge extracts action items, expectations, and ambiguities
// so students receive clear, neurodivergent-friendly outputs — not raw academic prose.
model SupervisorFeedbackParse {
  id                  String   @id @default(cuid())
  bookingId           String   @unique
  rawFeedback         String   @db.Text
  // Structured outputs — see lib/services/supervisor-bridge.ts for type shapes
  actionItems         Json // ActionItem[] — { title, suggestedOwnerLabel, priority, dueHint, riskIfIgnored, whatGoodLooksLike }[]
  expectations        Json // string[] — what the supervisor expects to see next
  ambiguities         Json // string[] — parts of the feedback that remain unclear
  hiddenAssumptions   Json     @default("[]") // string[] — things supervisor assumed but didn't say
  qualityExpectations Json     @default("[]") // QualityExpectation[] — { area, standard, example }[]
  deadlineWarnings    Json     @default("[]") // DeadlineWarning[] — { text, urgencyLevel, extractedDate }[]
  suggestedFirstSteps Json     @default("[]") // string[] — ordered first 3 actions
  studentSummary      String?  @db.Text // plain-English 2-3 sentence summary for students
  clarityScore        Float? // 0–1 estimate of how clear the raw feedback was
  parsedAt            DateTime @default(now())
  parsedBy            String   @default("rule-v1")

  booking ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// =============================================================================
// PROJECT BRAIN
// A persistent, structured memory for the project.
// This is the "second brain" of the team — capturing decisions, open questions,
// assumptions, and historical supervisor feedback so nothing falls through the cracks.
// =============================================================================

model DecisionLog {
  id           String   @id @default(cuid())
  projectId    String
  title        String
  rationale    String   @db.Text
  madeBy       String // userId
  madeAt       DateTime @default(now())
  impact       String?
  // Link to a specific task that triggered or implements this decision
  linkedTaskId String?
  isReversed   Boolean  @default(false)
  reversalNote String?  @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [madeBy], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([madeAt])
}

model OpenQuestion {
  id         String        @id @default(cuid())
  projectId  String
  question   String        @db.Text
  raisedBy   String // userId
  raisedAt   DateTime      @default(now())
  priority   PriorityLevel @default(MEDIUM)
  resolvedAt DateTime?
  resolution String?       @db.Text

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  raisedByUser User    @relation(fields: [raisedBy], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([resolvedAt])
}

model AssumptionRecord {
  id                String    @id @default(cuid())
  projectId         String
  statement         String    @db.Text
  loggedBy          String // userId
  loggedAt          DateTime  @default(now())
  validatedAt       DateTime?
  isInvalidated     Boolean   @default(false)
  invalidationNote  String?   @db.Text
  // Optional link to the milestone this assumption underpins
  linkedMilestoneId String?

  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  loggedByUser    User       @relation(fields: [loggedBy], references: [id], onDelete: Cascade)
  linkedMilestone Milestone? @relation("MilestoneAssumptions", fields: [linkedMilestoneId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// Stores supervisor feedback as a memory item so it can be referenced,
// searched, and surfaced by the AI bridge later.
model FeedbackMemory {
  id              String   @id @default(cuid())
  projectId       String
  authorId        String // supervisor userId
  content         String   @db.Text
  source          String   @default("meeting") // meeting | email | comment
  recordedAt      DateTime @default(now())
  linkedBookingId String?
  sentiment       String? // positive | constructive | critical
  // AI-extracted themes from the feedback: ["architecture", "deadline", "scope"]
  keyThemes       Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([authorId])
  @@index([recordedAt])
}

// =============================================================================
// AI INSIGHTS
// =============================================================================

// A general-purpose insight record produced by any layer of the AI system.
// Stored so students can review and acknowledge insights, and so we can measure
// how useful/accurate the AI layer is over time.
model AIInsight {
  id           String       @id @default(cuid())
  entityType   AIEntityType
  entityId     String // polymorphic — no hard FK
  insightType  InsightType
  title        String
  body         String       @db.Text
  // 0–1 confidence estimate from the generating system
  confidence   Float?
  acknowledged Boolean      @default(false)
  dismissedAt  DateTime?
  generatedBy  String       @default("rule-v1")
  createdAt    DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([insightType])
  @@index([acknowledged])
  @@index([createdAt])
}

// =============================================================================
// NOTIFICATIONS & ACTIVITY LOG
// =============================================================================

model Notification {
  id            String    @id @default(cuid())
  userId        String
  teamId        String?
  projectId     String?
  activityLogId String?
  type          String
  title         String
  body          String?   @db.Text
  read          Boolean   @default(false)
  readAt        DateTime?
  link          String?
  createdAt     DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityLog ActivityLog? @relation(fields: [activityLogId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([teamId])
  @@index([projectId])
  @@index([read])
  @@index([createdAt])
}

// General-purpose audit/activity trail and event log.
// Extended in this version to serve as the platform event system.
// Keep writes cheap (no updatedAt).
model ActivityLog {
  id         String   @id @default(cuid())
  teamId     String?
  projectId  String?
  userId     String? // actor (the user who performed the action)
  action     String // e.g. "task.created", "booking.confirmed"
  entity     String? // model name: "Task" | "ConsultationBooking" etc.
  entityId   String?
  title      String   @default("")
  message    String?  @db.Text
  visibility String   @default("TEAM") // PRIVATE | TEAM | SUPERVISOR | COORDINATOR | SYSTEM
  metadata   Json?
  createdAt  DateTime @default(now())

  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([teamId])
  @@index([projectId])
  @@index([userId])
  @@index([action])
  @@index([visibility])
  @@index([createdAt])
}

// =============================================================================
// ACADEMIC TERM FORMATION
// Part 2: semester/intake/batch foundation for the intelligent team formation engine.
// These models capture the when (AcademicTerm), who (StudentIntake), and how
// (FormationBatch + FormationRuleSet) of team formation — without containing the
// matching algorithm itself, which is a later part.
//
// Privacy note: CognitiveProfile remains entirely separate and is never joined
// here. Formation setup pages must only use operational data.
// =============================================================================

// An academic term (semester/year) that scopes a cohort of students and formation runs.
model AcademicTerm {
  id            String             @id @default(cuid())
  name          String
  code          String             @unique
  academicYear  Int?
  semesterLabel String?
  startsAt      DateTime?
  endsAt        DateTime?
  status        AcademicTermStatus @default(PLANNED)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  studentIntakes            StudentIntake[]
  formationBatches          FormationBatch[]
  teams                     Team[]
  projectTopics             ProjectTopic[]
  projectPreferences        ProjectPreference[]
  projectSelectionConflicts ProjectSelectionConflict[]
  teamFormationRuns         TeamFormationRun[]
  draftTeams                DraftTeam[]
}

// One row per student per academic term. Tracks intake status through the formation pipeline.
model StudentIntake {
  id               String              @id @default(cuid())
  termId           String
  studentProfileId String
  status           StudentIntakeStatus @default(PROFILE_PENDING)
  programme        String?
  cohortLabel      String?
  source           String?             @default("manual")
  notes            String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  term                 AcademicTerm            @relation(fields: [termId], references: [id], onDelete: Cascade)
  studentProfile       StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  batchMemberships     FormationBatchStudent[]
  draftTeamMemberships DraftTeamMember[]

  @@unique([termId, studentProfileId])
  @@index([termId])
  @@index([studentProfileId])
  @@index([status])
}

// A formation run: one batch groups a set of students to be formed into teams.
// Multiple batches can exist per term (e.g. re-runs, late additions).
model FormationBatch {
  id             String               @id @default(cuid())
  termId         String
  name           String
  status         FormationBatchStatus @default(DRAFT)
  targetTeamSize Int                  @default(4)
  minTeamSize    Int                  @default(3)
  maxTeamSize    Int                  @default(5)
  createdById    String?
  notes          String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  term      AcademicTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("FormationBatchCreator", fields: [createdById], references: [id], onDelete: SetNull)

  students          FormationBatchStudent[]
  ruleSet           FormationRuleSet?
  teams             Team[]
  teamFormationRuns TeamFormationRun[]
  draftTeams        DraftTeam[]

  @@index([termId])
  @@index([status])
  @@index([createdById])
}

// Each student included in a formation batch, with per-student override options.
model FormationBatchStudent {
  id              String                      @id @default(cuid())
  batchId         String
  studentIntakeId String
  status          FormationBatchStudentStatus @default(INCLUDED)
  locked          Boolean                     @default(false)
  exclusionReason String?                     @db.Text
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  batch         FormationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentIntake StudentIntake  @relation(fields: [studentIntakeId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentIntakeId])
  @@index([batchId])
  @@index([studentIntakeId])
  @@index([status])
}

// Configurable weights for the formation algorithm.
// Stored per batch so each run can use different priorities.
// Weights are integers — the algorithm normalises them at runtime.
// supportCompatibilityWeight is intentionally low and is used only as a
// private, safe support signal (not exposing cognitive profile specifics).
model FormationRuleSet {
  id                         String   @id @default(cuid())
  batchId                    String   @unique
  skillWeight                Int      @default(30)
  scheduleWeight             Int      @default(20)
  roleWeight                 Int      @default(15)
  preferenceWeight           Int      @default(15)
  capacityWeight             Int      @default(10)
  supportCompatibilityWeight Int      @default(5)
  supervisorCapacityWeight   Int      @default(5)
  // JSON: { "requiredRoles": ["backend", "frontend", "ux"], "mandatorySkills": ["Python"] }
  requiredCoverage           Json?
  notes                      String?  @db.Text
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  batch FormationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

// =============================================================================
// PART 3 — STUDENT FORMATION PROFILE MODELS
// =============================================================================

// The student's self-described formation profile: skills, availability,
// role preferences, capacity, and safe non-diagnostic support signals.
// Privacy: privateSupportNotes is student-only; NEVER query in
// coordinator/supervisor services. safeSupportPreferences stores
// anonymous support style signals, not diagnosis labels.
model StudentFormationProfile {
  id                      String                 @id @default(cuid())
  studentProfileId        String                 @unique
  status                  FormationProfileStatus @default(DRAFT)
  weeklyCapacityHours     Int                    @default(8)
  maxConcurrentTasks      Int                    @default(2)
  preferredTeamSize       Int?
  meetingPreference       String?
  communicationPreference String?
  workStylePreferences    Json?
  domainPreferences       Json?
  // Non-diagnostic safe support signals (e.g. "prefers_async_communication").
  // Never exposed to coordinators or supervisors in raw form.
  safeSupportPreferences  Json?
  // Fully private — student-only. NEVER query in coordinator/supervisor services.
  privateSupportNotes     String?                @db.Text
  completionScore         Int                    @default(0)
  submittedAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  studentProfile  StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skills          StudentSkill[]
  availability    StudentAvailabilitySlot[]
  rolePreferences StudentRolePreference[]
}

// A single skill entry in the student's formation profile.
// level 1–5, interest 1–5. Validated in service layer.
model StudentSkill {
  id         String           @id @default(cuid())
  profileId  String
  skillKey   String
  skillLabel String
  category   String
  level      Int
  interest   Int              @default(3)
  source     SkillLevelSource @default(SELF_ASSESSED)
  evidence   String?          @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  profile StudentFormationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillKey])
  @@index([profileId])
  @@index([skillKey])
  @@index([category])
}

// One availability block entry per day-of-week + time-block combination.
model StudentAvailabilitySlot {
  id        String            @id @default(cuid())
  profileId String
  dayOfWeek Weekday
  block     AvailabilityBlock
  level     AvailabilityLevel @default(AVAILABLE)
  note      String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  profile StudentFormationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, dayOfWeek, block])
  @@index([profileId])
  @@index([dayOfWeek, block])
  @@index([level])
}

// A student's preference and confidence level for each team role.
// avoid=true means this student explicitly does not want this role.
model StudentRolePreference {
  id              String   @id @default(cuid())
  profileId       String
  roleKey         String
  roleLabel       String
  preferenceLevel Int      @default(3)
  confidenceLevel Int      @default(3)
  avoid           Boolean  @default(false)
  note            String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile StudentFormationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, roleKey])
  @@index([profileId])
  @@index([roleKey])
  @@index([avoid])
}

// =============================================================================
// PART 4 — PROJECT TOPIC CATALOGUE MODELS
// =============================================================================

// A coordinator/supervisor-defined project topic available for a term.
// This is NOT the same as the operational Project model — it is a pre-formation
// catalogue item. Part 5/6 may link or convert a ProjectTopic to a real Project.
model ProjectTopic {
  id                  String                 @id @default(cuid())
  termId              String
  supervisorProfileId String?
  title               String
  slug                String
  description         String                 @db.Text
  domain              String?
  difficulty          ProjectTopicDifficulty @default(MEDIUM)
  status              ProjectTopicStatus     @default(DRAFT)
  minTeams            Int                    @default(0)
  maxTeams            Int                    @default(1)
  maxStudents         Int?
  // JSON arrays of skill keys, e.g. ["backend", "database"]
  requiredSkills      Json?
  preferredSkills     Json?
  deliverables        Json?
  tags                Json?
  createdById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  term              AcademicTerm               @relation(fields: [termId], references: [id], onDelete: Cascade)
  supervisorProfile SupervisorProfile?         @relation(fields: [supervisorProfileId], references: [id], onDelete: SetNull)
  createdBy         User?                      @relation("ProjectTopicCreator", fields: [createdById], references: [id], onDelete: SetNull)
  preferences       ProjectPreference[]
  conflicts         ProjectSelectionConflict[]
  draftTeams        DraftTeam[]
  draftTeamWarnings DraftTeamWarning[]

  @@unique([termId, slug])
  @@index([termId])
  @@index([supervisorProfileId])
  @@index([status])
  @@index([difficulty])
}

// A student's ranked preference for a project topic within a term.
// Students can save drafts before submitting. Once submitted, they can
// update and re-submit. Coordinators see aggregate demand only.
model ProjectPreference {
  id               String                  @id @default(cuid())
  termId           String
  studentProfileId String
  topicId          String
  rank             Int
  status           ProjectPreferenceStatus @default(DRAFT)
  motivation       String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  term           AcademicTerm   @relation(fields: [termId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  topic          ProjectTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([termId, studentProfileId, rank])
  @@unique([termId, studentProfileId, topicId])
  @@index([termId])
  @@index([studentProfileId])
  @@index([topicId])
  @@index([status])
  @@index([rank])
}

// A detected conflict in project topic selection for a term.
// Recalculated deterministically by the conflict detection service.
// Coordinators use these to resolve demand imbalances before formation.
model ProjectSelectionConflict {
  id               String                           @id @default(cuid())
  termId           String
  topicId          String?
  studentProfileId String?
  type             ProjectSelectionConflictType
  severity         ProjectSelectionConflictSeverity @default(MEDIUM)
  title            String
  message          String                           @db.Text
  metadata         Json?
  resolved         Boolean                          @default(false)
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  term           AcademicTerm    @relation(fields: [termId], references: [id], onDelete: Cascade)
  topic          ProjectTopic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([termId])
  @@index([topicId])
  @@index([studentProfileId])
  @@index([type])
  @@index([severity])
  @@index([resolved])
}

// =============================================================================
// PART 5 — TEAM FORMATION ENGINE (DRAFT RESULTS)
//
// These models persist the output of the deterministic team-formation engine.
// They are pre-approval "what-if" results ONLY. They never modify or replace the
// operational Team / TeamMember / Project models. Part 6 will let coordinators
// review, adjust, approve, and publish drafts into real operational teams.
//
// Privacy note: the engine reads ONLY operational data and the safe,
// non-diagnostic StudentFormationProfile.safeSupportPreferences signal. It never
// reads CognitiveProfile or privateSupportNotes, and never stores raw support
// preference JSON in coordinator-facing fields.
// =============================================================================

// One execution of the deterministic engine for a formation batch.
model TeamFormationRun {
  id               String                 @id @default(cuid())
  termId           String
  batchId          String
  status           TeamFormationRunStatus @default(QUEUED)
  algorithmVersion String                 @default("deterministic-v1")
  createdById      String?
  publishedAt      DateTime?
  publishedById    String?
  publishSummary   Json?
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  failureReason    String?                @db.Text
  settingsSnapshot Json?
  summary          Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  term        AcademicTerm       @relation(fields: [termId], references: [id], onDelete: Cascade)
  batch       FormationBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("TeamFormationRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy User?              @relation("TeamFormationRunPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  draftTeams  DraftTeam[]
  members     DraftTeamMember[]
  warnings    DraftTeamWarning[]

  @@index([termId])
  @@index([batchId])
  @@index([status])
  @@index([createdById])
  @@index([publishedById])
}

// A draft team suggested by the engine. Pre-approval only.
model DraftTeam {
  id                        String          @id @default(cuid())
  runId                     String
  termId                    String
  batchId                   String
  topicId                   String?
  supervisorProfileId       String?
  name                      String
  status                    DraftTeamStatus @default(DRAFT)
  overallScore              Int             @default(0)
  skillScore                Int             @default(0)
  scheduleScore             Int             @default(0)
  roleScore                 Int             @default(0)
  preferenceScore           Int             @default(0)
  capacityScore             Int             @default(0)
  supportCompatibilityScore Int             @default(0)
  supervisorCapacityScore   Int             @default(0)
  explanation               String?         @db.Text
  metadata                  Json?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  run               TeamFormationRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  term              AcademicTerm       @relation(fields: [termId], references: [id], onDelete: Cascade)
  batch             FormationBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  topic             ProjectTopic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  supervisorProfile SupervisorProfile? @relation(fields: [supervisorProfileId], references: [id], onDelete: SetNull)
  members           DraftTeamMember[]
  warnings          DraftTeamWarning[]
  publishedTeam     Team?              @relation("DraftTeamPublishedTeam")

  @@index([runId])
  @@index([termId])
  @@index([batchId])
  @@index([topicId])
  @@index([supervisorProfileId])
  @@index([status])
  @@index([overallScore])
}

// A suggested member placement within a draft team, with a suggested role.
model DraftTeamMember {
  id                 String   @id @default(cuid())
  runId              String
  draftTeamId        String
  studentIntakeId    String
  studentProfileId   String
  suggestedRoleKey   String?
  suggestedRoleLabel String?
  roleConfidence     Int      @default(0)
  fitScore           Int      @default(0)
  explanation        String?  @db.Text
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  run            TeamFormationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  draftTeam      DraftTeam        @relation(fields: [draftTeamId], references: [id], onDelete: Cascade)
  studentIntake  StudentIntake    @relation(fields: [studentIntakeId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([runId, studentProfileId])
  @@unique([draftTeamId, studentProfileId])
  @@index([runId])
  @@index([draftTeamId])
  @@index([studentIntakeId])
  @@index([studentProfileId])
  @@index([suggestedRoleKey])
}

// A warning raised by the engine, attachable at run/team/student/topic level.
model DraftTeamWarning {
  id               String                   @id @default(cuid())
  runId            String
  draftTeamId      String?
  studentProfileId String?
  topicId          String?
  type             FormationWarningType
  severity         FormationWarningSeverity @default(MEDIUM)
  title            String
  message          String                   @db.Text
  metadata         Json?
  resolved         Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  run            TeamFormationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  draftTeam      DraftTeam?       @relation(fields: [draftTeamId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile?  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  topic          ProjectTopic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([draftTeamId])
  @@index([studentProfileId])
  @@index([topicId])
  @@index([type])
  @@index([severity])
  @@index([resolved])
}
