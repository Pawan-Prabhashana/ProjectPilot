# ──────────────────────────────────────────────────────────────
# ProjectPilot Neuro — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Local (Homebrew PostgreSQL on macOS — use your system username):
#   DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/projectpilot"
# Local with credentials:
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/projectpilot"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projectpilot"

# ── NextAuth ──────────────────────────────────────────────────
# Keep NEXTAUTH_URL as localhost:3000 during local development.
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ── Field Encryption (AES-256-GCM) ───────────────────────────
# Used for encrypting sensitive fields at rest (e.g. MeetingNote.privateNote).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_SECRET="your-32-byte-base64-secret-here"

# ── Explainability Layer ──────────────────────────────────────
# Controls how ProjectPilot generates human-readable explanations.
# "deterministic" (default) — always works offline, no API key needed.
# "ai_enhanced"  — optionally enhances summaries if AI_API_KEY is set;
#                  falls back to deterministic if key is absent/invalid.
EXPLAINABILITY_MODE="deterministic"

# Optional AI provider config (not required — app works fully without these).
# If set, AI_API_KEY must be a valid key for the chosen AI_PROVIDER.
# Leave blank or omit entirely to use deterministic explanations only.
# AI_PROVIDER=""
# AI_API_KEY=""
